{
  "name": "adulis-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Adulis platform monorepo, replacement lineage rebuild-20261125: one API, two processes, one PostgreSQL.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "pnpm -r --filter '!@adulis/console' build",
    "typecheck": "pnpm -r --filter '!@adulis/console' typecheck",
    "lint": "eslint .",
    "test": "pnpm -r --filter '!@adulis/console' test",
    "test:integration": "pnpm --filter @adulis/api test:integration",
    "db:bootstrap": "pnpm --filter @adulis/api db:bootstrap",
    "db:migrate": "pnpm --filter @adulis/api db:migrate",
    "generate:openapi": "pnpm --filter @adulis/api generate:openapi",
    "generate:api-client": "pnpm --filter @adulis/api-client generate",
    "verify:deps": "depcruise apps/api packages --config .dependency-cruiser.cjs",
    "verify:deps-fires": "bash ops/scripts/verify-deps-fires.sh",
    "verify:docs-ascii": "node ops/scripts/verify-docs-ascii.mjs",
    "verify:tokens": "node ops/scripts/verify-tokens.mjs",
    "verify:retired": "node ops/rebuild/verify-retired-absence.mjs",
    "verify:disposable-db": "bash ops/rebuild/disposable-db.test.sh",
    "verify:contract": "node ops/rebuild/verify-contract-current.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "dependency-cruiser": "18.2.0",
    "eslint": "9.39.5",
    "globals": "16.5.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "msgpackr-extract"
    ]
  }
}

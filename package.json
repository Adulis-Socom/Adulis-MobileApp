{
  "name": "adulis-platform",
  "version": "0.0.0",
  "private": true,
  "description": "Adulis platform monorepo \u00e2\u20ac\u201d one API, four clients, two processes, one PostgreSQL.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "pnpm --parallel \"/^dev:/\"",
    "dev:api": "pnpm --filter @adulis/api dev",
    "dev:worker": "pnpm --filter @adulis/api dev:worker",
    "dev:console": "pnpm --filter @adulis/console dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --check .",
    "gates": "node --env-file-if-exists=.env ops/scripts/gates.mjs",
    "ci:local": "pnpm gates",
    "db:migrate": "node --env-file-if-exists=.env node_modules/node-pg-migrate/bin/node-pg-migrate.js -d DATABASE_URL_MIGRATE -m db/migrations -j sql up",
    "db:check": "node --env-file-if-exists=.env ops/scripts/db-check.mjs",
    "verify:permission-doc": "node ops/scripts/verify-permission-doc.mjs",
    "db:determinism": "node --env-file-if-exists=.env ops/scripts/db-determinism.mjs",
    "db:verify-extensions": "node --env-file-if-exists=.env ops/scripts/verify-extensions.mjs",
    "db:reset": "node --env-file-if-exists=.env ops/scripts/db-reset.mjs",
    "db:seed": "node --env-file-if-exists=.env ops/scripts/seed.mjs",
    "verify:docs-ascii": "node ops/scripts/verify-docs-ascii.mjs",
    "verify:docs": "pnpm verify:permission-doc && pnpm verify:docs-ascii",
    "verify:deps": "depcruise apps packages --config .dependency-cruiser.cjs",
    "verify:deps-fires": "bash ops/scripts/verify-deps-fires.sh",
    "mock:api": "node ops/scripts/mock-api.mjs",
    "verify:contract": "node ops/scripts/verify-contract.mjs",
    "generate:openapi": "pnpm --filter @adulis/api generate:openapi",
    "generate:api-client": "pnpm --filter @adulis/api-client generate",
    "verify:error-locale": "node ops/scripts/verify-error-locale.mjs",
    "verify:mt-keys": "node ops/scripts/verify-mt-keys.mjs",
    "verify:boot-smoke": "node ops/scripts/verify-boot-smoke.mjs",
    "verify:appendix": "node --env-file-if-exists=.env ops/scripts/verify-appendix.mjs",
    "verify:orphan-sweep": "node --env-file-if-exists=.env ops/scripts/verify-orphan-sweep.mjs",
    "verify:console-e2e": "node --env-file-if-exists=.env ops/scripts/verify-console-e2e.mjs",
    "verify:deferred-values": "node --env-file-if-exists=.env ops/scripts/verify-deferred-values.mjs",
    "worker:install": "node ops/scripts/install-worker-schema.mjs",
    "generate:appendix": "node --env-file-if-exists=.env ops/scripts/generate-appendix.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "globals": "16.5.0",
    "node-pg-migrate": "9.0.0",
    "pg": "8.23.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "@stoplight/prism-cli": "5.14.2",
    "dependency-cruiser": "18.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ]
  }
}

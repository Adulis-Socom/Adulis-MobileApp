node_modules/
dist/
.env
coverage/
*.local

# build and tool output
.turbo/
*.tsbuildinfo
apps/console/dist/
apps/api/dist/

# never commit a real environment file; .env.example is the only one tracked
.env.*
!.env.example

# ops/scripts/verify-deps-fires.sh plants these for a few hundred milliseconds to
# prove the dependency rules fire. A crashed run must not leave one committable.
**/__depcruise_probe*.ts

# Development OTP codes (ADU-RUL-03 S1.1). The fake SMS adapter appends here
# instead of stdout, because the redaction allow-list cannot carry an OTP and
# console.* is banned in apps/api. Never commit it; it holds live codes and
# phone numbers for whoever ran the dev loop.
.dev-sms.log
apps/console/e2e/.auth/
apps/console/e2e/.walk/
apps/console/test-results/
apps/console/playwright-report/

# apps/mobile (ADU-MOB-01 S17.2, landed by WO-0b). Prebuild output, the
# Expo/Metro cache, the export the `build` gate writes -- and every signing
# artefact, because a key in git is unrecoverable in the way ADU-MOB-07 O1
# describes. expo-env.d.ts is TRACKED: tsc in CI needs it without running the CLI.
apps/mobile/.expo/
apps/mobile/android/
apps/mobile/ios/
apps/mobile/dist/
*.jks
*.keystore
*.p8
*.p12
*.pem
*.mobileprovision
credentials.json
keystore.properties
google-services.json
GoogleService-Info.plist

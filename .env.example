# Adulis Platform — environment template (ADU-CON-02 v3.0 section 19)
#
# Copy to .env and fill LOCAL values. Never commit .env; CI secret-scan enforces.
# EVERY VALUE BELOW IS FAKE. Anything per-market is a configuration ROW in the
# database, never an environment variable (section 19).
#
# TIER-0 NOTE ON NAMES: section 19 fixes the count (~13) and names DATABASE_URL,
# DATABASE_URL_MIGRATE and CONSOLE_ORIGIN exactly, but writes the rest as globs
# ("three key secrets", "R2_* x4", "SMS_PRIMARY_*/SMS_SECONDARY_*"). The exact
# spellings inside those globs are TIER-0 PLACEHOLDERS pending ADU-SEC-01 v1.1
# and ADU-DB-01 v1.7; each is traced below to the column it serves. Renaming
# them is a documentation amendment, not a code change.

# --- Database (2) --------------------------------------------------------
# NOTE ON THE PORT: docker-compose maps host ${POSTGRES_HOST_PORT:-5432} to the
# container's 5432. If you already run PostgreSQL locally on 5432, both will
# listen and YOUR LOCAL ONE ANSWERS FIRST — which surfaces as "password
# authentication failed", not as a port clash. Set POSTGRES_HOST_PORT=5433 and
# change 5432 to 5433 in both URLs below.
# Application role. Kysely's two pools (app + financial) share this role;
# the privilege boundary is the schema grant, not a second credential (6.2).
#
# TIER-1 NOTE: locally this is the compose BOOTSTRAP role, not adulis_app.
# adulis_app is created NOLOGIN by migration 01 and is deliberately NOT a
# superuser — a superuser bypasses every privilege check, which would make the
# verification/financial boundary untestable. Granting adulis_app LOGIN and a
# password is a provisioning step, never a migration: a password in a migration
# is a secret in git.
DATABASE_URL=postgres://adulis_app:local-dev-password@localhost:5432/adulis
# Job-runner role. The WORKER connects as adulis_jobs, never as adulis_app:
# the two processes hold different privileges on purpose, and T4's first
# finding was that adulis_jobs could not reach schema core at all. Provisioned
# the same way as adulis_app - LOGIN and a password are a host concern, never
# a migration.
DATABASE_URL_JOBS=postgres://adulis_jobs:local-dev-password@localhost:5432/adulis
# DDL-only adulis_migrate role. Used by pnpm db:migrate from CI, never by hand
# against production (3.5).
#
# TIER-0 NOTE: the adulis_migrate ROLE DOES NOT EXIST YET. Roles are created by
# migration 1 (ADU-DB-01 section 28), which is Tier 1. Until that migration
# lands, point this at the local bootstrap superuser (adulis_app in the compose
# container) so `pnpm db:migrate` can create its own migrations table:
#   postgres://adulis_app:local-dev-password@localhost:5432/adulis
# Restore the adulis_migrate value the moment migration 1 exists. In production
# the two roles are never the same.
DATABASE_URL_MIGRATE=postgres://adulis_migrate:local-dev-password@localhost:5432/adulis

# --- Key secrets (3) -----------------------------------------------------
# Versioned environment secrets, "..._V1"; rotation = add _V2 and run the
# re-encrypt job. encryption_key_ref was built for this. KMS when a provider
# offers one (section 18). Key material NEVER enters Postgres (R15).
# Serves financial.payment_evidence.encryption_key_ref; AES-256-GCM in ~64 KB
# AEAD frames so decryption streams in constant memory (R18).
EVIDENCE_ENCRYPTION_KEY_V1=00000000000000000000000000000000000000000000
# Serves financial.payout_credential.encryption_key_ref (account_ciphertext,
# account_name_ciphertext). Write-once; a bank change writes a new row.
PAYOUT_ENCRYPTION_KEY_V1=11111111111111111111111111111111111111111111
# Serves verification.identity_attestation.id_hash / id_hash_key_version.
# A keyed hash: the ID number is never stored, only its keyed digest.
IDENTITY_HASH_KEY_V1=22222222222222222222222222222222222222222222

# --- Cloudflare R2 (4) ---------------------------------------------------
# Media never transits the API: the client PUTs derivatives directly to R2 via
# signed URLs and the API only validates and HEADs them (8.1).
R2_ACCOUNT_ID=0000000000000000000000000000000f
R2_ACCESS_KEY_ID=fake-access-key-id
R2_SECRET_ACCESS_KEY=fake-secret-access-key
R2_BUCKET=adulis-media-local

# --- SMS (2) -------------------------------------------------------------
# Primary = Ethiopian aggregator (AfroMessage / GeezSMS), SELECTED IN PHASE 0 BY
# MEASURED DELIVERY RATE — open item O-5b, so this value is a placeholder for a
# vendor that is not yet chosen. Local and staging use the terminal adapter,
# which prints OTPs to stdout (section 19).
SMS_PRIMARY_API_KEY=terminal-adapter-no-key-needed-locally
# Secondary = Twilio Verify with voice fallback. Failover on non-delivery inside
# the configured window; the user sees one countdown, never two providers.
SMS_SECONDARY_API_KEY=fake-twilio-verify-key

# --- Origin (1) ----------------------------------------------------------
# Exact CORS allow-origin for the console. Not a wildcard: the session cookie is
# sent with credentials: 'include', and an exact Origin check is one of the two
# independent CSRF controls (4.1).
CONSOLE_ORIGIN=http://localhost:5173

# --- Process (not part of section 19's ~13) ------------------------------
# NODE_ENV is for the API and the tooling. Do NOT let it reach a console build:
# Vite picks React's development build from it, which doubles the bundle from
# 193 kB to 391 kB and ships development warnings to sellers on metered
# connections. `pnpm build` does not read this file; sourcing it into a shell
# first would. CI asserts the production build, so this cannot ship unnoticed.
NODE_ENV=development
PORT=3000

# --- Front-end (ADU-REPO-01 S5.1) ----------------------------------------
# The API ORIGIN, never a versioned path. ADU-API-01 writes every route as
# /v1/..., so the /v1 belongs in the contract's own path keys - Prism ignores a
# prefix carried only in servers[].url and would 404 on every mocked route.
# Point it at the Prism mock for local work and flip it to the real origin when
# the endpoint lands; that flip is the whole "no front-end workstream is ever
# blocked on the backend" guarantee, and it is one variable.
VITE_API_BASE_URL=http://127.0.0.1:4010

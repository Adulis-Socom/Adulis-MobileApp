{
  "name": "@adulis/tokens",
  "version": "0.0.0",
  "private": true,
  "description": "Design tokens -- values only, no components. Two colour modes under identical role names for the web surfaces; a React Native role set under ./native.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.18 <23"
  },
  "scripts": {
    "build": "echo \"@adulis/tokens: consumed as source\"",
    "test": "node --experimental-strip-types --test test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./native": "./src/native/index.ts",
    "./tokens.css": "./tokens.css"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@adulis/config": "workspace:*"
  }

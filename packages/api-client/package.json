{
  "name": "@adulis/api-client",
  "version": "0.0.0",
  "private": true,
  "description": "The seam: types GENERATED from contracts/openapi.json (replacement API). Never a hand-authored DTO.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "openapi-typescript ../../contracts/openapi.json --alphabetize --output ./src/schema.d.ts",
    "generate:check": "openapi-typescript ../../contracts/openapi.json --alphabetize --output ./src/schema.d.ts --check",
    "build": "echo \"@adulis/api-client: consumed as TypeScript source\"",
    "test": "tsc --noEmit -p tsconfig.test.json",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@adulis/config": "workspace:*",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}

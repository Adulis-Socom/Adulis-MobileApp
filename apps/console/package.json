{
  "name": "@adulis/console",
  "version": "0.0.0",
  "private": true,
  "description": "Adulis Seller Console — Vite React SPA on Cloudflare Pages.",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "echo \"@adulis/console: unit tests still absent. The e2e harness is `pnpm verify:console-e2e` (gate 23) -- it needs a reset database and a running API, so it is a gate rather than a package test.\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "lint": "eslint src",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@adulis/api-client": "workspace:*",
    "@adulis/locale": "workspace:*",
    "@adulis/tokens": "workspace:*",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "7.18.3"
  },
  "devDependencies": {
    "@adulis/config": "workspace:*",
    "@playwright/test": "1.56.1",
    "@types/node": "22.10.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}

{
  "name": "@adulis/console",
  "version": "0.0.0",
  "private": true,
  "description": "The Seller Console (clean replacement, rebuild-20261125): React + Vite SPA over @adulis/tokens. Development fixtures are build-time only.",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev:fixtures": "ADULIS_FIXTURES=on vite --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "build:fixture-control": "ADULIS_FIXTURES=on vite build --mode fixture-control --outDir dist-fixture",
    "verify:release": "node scripts/verify-release.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@adulis/api-client": "workspace:*",
    "@adulis/locale": "workspace:*",
    "@adulis/tokens": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.7"
  },
  "devDependencies": {
    "@adulis/config": "workspace:*",
    "@axe-core/playwright": "4.14.1",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.1",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.5.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vite": "7.3.8",
    "vitest": "4.1.12"
  }
}

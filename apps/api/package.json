{
  "name": "@adulis/api",
  "version": "0.1.0",
  "private": true,
  "description": "Adulis replacement API and worker: one NestJS-on-Fastify codebase, two processes (RB25-D01, ARC-BE-02..04).",
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration --runInBand --forceExit --detectOpenHandles",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "db:bootstrap": "node dist/db/bootstrap.js",
    "db:migrate": "node dist/db/migrate.js",
    "generate:openapi": "node dist/openapi/generate.js"
  },
  "dependencies": {
    "@fastify/helmet": "13.2.0",
    "@nestjs/common": "11.2.12",
    "@nestjs/core": "11.2.12",
    "@nestjs/platform-fastify": "11.2.12",
    "@nestjs/swagger": "11.4.8",
    "bullmq": "5.81.6",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "ioredis": "5.11.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@adulis/config": "workspace:*",
    "@adulis/locale": "workspace:*",
    "@nestjs/testing": "11.2.12",
    "@swc/core": "1.16.22",
    "@swc/jest": "0.2.39",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.1",
    "@types/pg": "8.23.1",
    "jest": "30.5.2",
    "typescript": "5.9.3"
  }
}

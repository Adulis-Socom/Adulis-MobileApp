# Copy to apps/mobile/.env (git-ignored). Expo inlines every EXPO_PUBLIC_* value into the
# app bundle, where anyone can read it: put only the PUBLIC API origin here, never a key,
# token or secret. An origin, not a path - /v1 lives in the contract's path keys.
#
# The Android emulator reaches the host machine at 10.0.2.2.

# The real local API (pnpm dev:api):
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3000

# Or the contract mock, for contract-only work (pnpm mock:api):
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:4010

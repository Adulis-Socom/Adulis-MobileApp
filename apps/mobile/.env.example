# Copy to apps/mobile/.env (git-ignored). Expo inlines every EXPO_PUBLIC_* value into the
# app bundle, where anyone can read it: put only PUBLIC values here, never a key, token or
# secret. The values below are fake and local-only.
#
# The public API origin (an origin, not a path). The Android emulator reaches the host at 10.0.2.2.
# No business operation exists in the generated contract yet, so the live transport fails closed
# and sends nothing (GOV-06); this origin is used once an operation is generated.
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3000

# Development-only demonstration data (GOV-06). Honoured ONLY when __DEV__ is true: a release
# export folds the branch away and scripts/verify-release.mjs proves the fixtures are absent.
# Never set this in an EAS profile or an OTA publish.
# EXPO_PUBLIC_ADULIS_FIXTURES=on

{
  "name": "@adulis/mobile",
  "version": "0.0.0",
  "private": true,
  "description": "Adulis mobile app: one application with Buyer, Seller Companion and Courier modes.",
  "license": "UNLICENSED",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "android": "expo run:android",
    "build": "expo export --output-dir dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node scripts/check-locale-imports.mjs && jest"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  },
  "dependencies": {
    "@adulis/api-client": "workspace:*",
    "@adulis/locale": "workspace:*",
    "@adulis/tokens": "workspace:*",
    "@expo/vector-icons": "^15.1.1",
    "@shopify/flash-list": "2.3.2",
    "@tanstack/react-query": "5.107.1",
    "expo": "~58.0.24",
    "expo-constants": "~58.0.16",
    "expo-font": "~58.0.12",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.17",
    "expo-network": "~58.0.5",
    "expo-router": "~58.0.31",
    "expo-secure-store": "~58.0.3",
    "expo-sqlite": "~58.0.16",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@adulis/config": "workspace:*",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "test-renderer": "1.3.0",
    "typescript": "5.9.3"
  }
}

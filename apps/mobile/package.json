{
  "name": "@adulis/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Adulis mobile app, Buyer Mode. Expo + React Native. Governed by ADU-MOB-01 v1.2; built by ADU-MOB-WO-01 v1.2 onward.",
  "license": "UNLICENSED",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --dev-client",
    "build": "expo export --platform android --output-dir dist",
    "build:dev-client": "eas build --profile development --platform all",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest && node --test scripts/gates/gates.test.mjs scripts/hooks/hooks.test.mjs",
    "gates": "node scripts/gates/run.mjs --self-test",
    "precommit": "node scripts/hooks/pre-commit-gate.mjs --check",
    "api:generate": "pnpm --filter @adulis/api-client generate"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/**/__tests__/**/*.test.[jt]s?(x)"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(\\.pnpm/)?((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|@adulis/.*))"
    ]
  },
  "dependencies": {
    "@adulis/api-client": "workspace:*",
    "@adulis/locale": "workspace:*",
    "@adulis/tokens": "workspace:*",
    "expo": "57.0.20",
    "expo-camera": "57.0.4",
    "expo-constants": "57.0.17",
    "expo-dev-client": "57.0.18",
    "expo-font": "57.0.3",
    "expo-linking": "57.0.9",
    "expo-notifications": "57.0.17",
    "expo-router": "57.0.19",
    "expo-secure-store": "57.0.3",
    "expo-splash-screen": "57.0.8",
    "expo-sqlite": "57.0.2",
    "expo-status-bar": "57.0.1",
    "expo-updates": "57.0.21",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2"
  },
  "devDependencies": {
    "@adulis/config": "workspace:*",
    "@babel/core": "7.29.7",
    "@jest/globals": "29.7.0",
    "@react-native/metro-config": "0.86.3",
    "@testing-library/react-native": "13.3.3",
    "@types/react": "19.2.18",
    "jest": "29.7.0",
    "jest-expo": "57.0.5",
    "react-dom": "19.2.3",
    "react-native-worklets": "0.10.1",
    "react-test-renderer": "19.2.3",
    "typescript": "5.9.3"
  }
}

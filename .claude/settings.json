{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(../api/**)",
      "Edit(../api/**)",
      "Read(../console/**)",
      "Edit(../console/**)",
      "Read(../storefront/**)",
      "Edit(../storefront/**)",
      "Read(../../db/**)",
      "Edit(../../db/migrations/**)",
      "Read(../../.env)",
      "Read(../../.env.*)",
      "Read(../../**/*.pem)",
      "Read(../../**/*.p8)",
      "Read(../../**/*.p12)",
      "Read(../../**/*.keystore)",
      "Read(../../**/*.jks)",
      "Read(../../**/*.mobileprovision)",
      "Read(../../**/credentials.json)",
      "Read(../../**/keystore.properties)",
      "Read(../../**/google-services.json)",
      "Read(../../**/GoogleService-Info.plist)",
      "Read(../../**/.dev-sms.log)",
      "Edit(../../contracts/openapi.json)",
      "Edit(../../packages/api-client/src/schema.d.ts)"
    ],
    "ask": [
      "Read(../../packages/**)",
      "Read(../../contracts/**)",
      "Edit(../../packages/**)",
      "Edit(../../contracts/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/pre-commit-gate.mjs",
            "timeout": 900
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/guard-sensitive-writes.mjs",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/post-edit-format.mjs",
            "timeout": 120
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "expo@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true
  },
  "claudeMdExcludes": [
    "**/apps/api/**/CLAUDE.md",
    "**/apps/console/**/CLAUDE.md",
    "**/apps/storefront/**/CLAUDE.md",
    "**/db/**/CLAUDE.md"
  ]
}

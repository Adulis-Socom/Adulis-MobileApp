          }
        },
        "tags": [
          "Onboarding"
        ]
      }
    },
    "/v1/seller/readiness": {
      "get": {
        "operationId": "OnboardingController_readiness",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "The nine readiness items — a state, not a failure.",
        "tags": [
          "Onboarding"
        ]
      }
    },
    "/v1/seller/social-accounts": {
      "post": {
        "operationId": "OnboardingController_createSocialAccount",
        "parameters": [],
        "responses": {

    "/v1/seller/social-accounts/{id}/verify": {
      "post": {
        "operationId": "OnboardingController_verifySocialAccount",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "description": ""
          }
        },
        "summary": "Fetch and match; captures the follower count at verification.",

        },
        "summary": "Create the seller. The first eligibility evaluation runs inline.",
        "tags": [
          "Onboarding"
        ]
      }
    },
    "/v1/seller/availability": {
      "put": {
        "operationId": "OnboardingController_putAvailability",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "The whole weekly pattern. Zero windows is valid and means closed.",
        "tags": [
          "Onboarding"
        ]
      }
    },
    "/v1/seller/availability-overrides": {
      "get": {
        "operationId": "OnboardingController_getOverrides",
        "parameters": [
          {
            "name": "from",
            "required": true,
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "required": true,
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "tags": [
          "Onboarding"
        ]
      }
    },
    "/v1/seller/availability-overrides/{date}": {
      "put": {
        "operationId": "OnboardingController_putOverride",
        "parameters": [
          {
            "name": "date",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Marks the store closed on that date. Idempotent by path; no key.",
        "tags": [
          "Onboarding"
        ]
      },
      "delete": {
        "operationId": "OnboardingController_deleteOverride",
        "parameters": [
          {
            "name": "date",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": ""
          }
        },
        "summary": "Removes the closure. 204 whether or not it existed.",
        "tags": [
          "Onboarding"
        ]
      }
    },

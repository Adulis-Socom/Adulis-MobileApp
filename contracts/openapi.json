{
  "openapi": "3.0.0",
  "paths": {
    "/v1/bootstrap": {
      "get": {
        "operationId": "BootstrapController_bootstrap",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BootstrapResponseDto"
                }
              }
            }
          }
        },
        "summary": "Client floor, market configuration and the clock reference.",
        "tags": [
          "Bootstrap"
        ]
      }
    },
    "/v1/seller": {
